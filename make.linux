#
#
#  The machine (platform) identifier to append to the library names
#
#  CIP-0013 P1: default link is OpenBLAS (libopenblas-dev on Ubuntu/CI).
#  make RELEASE=1 selects -O2 -DNDEBUG and turns GPC_CHECKS off.
#
SHELL = /bin/sh

PLAT = _LINUX
# Tuned BLAS/LAPACK (REQ-0007 / CIP-0013). Override via make.inc if needed.
LAPACKLIBS = -lopenblas
F2CLIB = -lgfortran
# commands to make statically&dynamically linked libraries and their extensions
LIBSCOMMAND = ar rcs
LIBDCOMMAND = gcc -shared -o
LIBSEXT = .a
LIBDEXT = .so

# Uncomment these lines to set up the MATLAB interface.
#MATLABLIBS = -lmat -lmx
#MATLABBASE=/usr/local/pkg/matlab/
#MATLABRUNLIBDIR=${MATLABBASE}/bin/glnx86
#MATLABLIBDIR=${MATLABBASE}/bin/glnx86
#MATLABINCLUDE=${MATLABBASE}/extern/include
#MATLABXLINKFLAG=-L${MATLABLIBDIR} -Xlinker -rpath -Xlinker ${MATLABRUNLIBDIR} 
#MATLABFLAG=-D_NDLMATLAB

# Optional libmatio path for reading numeric .mat fixtures without MATLAB (CIP-0001).
# Enable with: make USE_MATIO=1 testMatrix
ifeq ($(USE_MATIO),1)
MATIOFLAG = -D_NDLMATIO
MATIOLIBS = -lmatio
endif

# gcov instrumentation for coverage reports (CIP-0004).
# Enable with: make USE_MATIO=1 COVERAGE=1 matio-tests
ifeq ($(COVERAGE),1)
COVERAGEFLAGS = --coverage -O0
endif

# Default to the project root so -I is never empty when MATLAB is disabled.
# When enabling MATLAB above, set MATLABINCLUDE and it will be used instead.
ifeq ($(strip $(MATLABINCLUDE)),)
INCLUDE = .
else
INCLUDE = $(MATLABINCLUDE)
endif
LD=g++
LDFLAGS = ${MATLABLIBS} ${MATIOLIBS} ${LAPACKLIBS} ${F2CLIB} -lc ${MATLABXLINKFLAG} $(COVERAGEFLAGS)
CC=g++
# C++17: dynamic exception specifications removed from the sources (CIP-0002).
# CIP-0013: RELEASE=1 is the timed / documented Linux run path.
ifeq ($(RELEASE),1)
CCFLAGS = -std=c++17 -O2 -DNDEBUG -DGPC_CHECKS=0 -fPIC -I$(INCLUDE) -D$(PLAT) $(MATLABFLAG) $(MATIOFLAG) $(COVERAGEFLAGS)
else
CCFLAGS = -std=c++17 -ggdb -DDBG -DGPC_CHECKS=1 -fPIC -I$(INCLUDE) -D$(PLAT) $(MATLABFLAG) $(MATIOFLAG) $(COVERAGEFLAGS)
endif
FC=gfortran
FCFLAGS = -funroll-all-loops -O3 -fPIC
